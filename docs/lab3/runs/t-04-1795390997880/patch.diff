+import { fileURLToPath } from 'node:url';
+import { dirname, resolve } from 'node:path';
+import { loadIndex, type IndexFile } from '../rag/store';
+import { geminiEmbedder, type Embedder } from '../rag/embed';
+import { bm25From, type Bm25Index } from '../rag/search';
+import type { Deps } from './tools';
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const ROOT = resolve(HERE, '../..');
+
+export function loadIndexData(): Deps {
+  const embedder = geminiEmbedder(768);
+  const index = loadIndex(resolve(ROOT, 'data/index.json'), embedder);
+  return { index, words: bm25From(index), embedder };
+}
