+/**
+ * Перевіряє, чи є помилка причиною перевищення квоти (429 / RESOURCE_EXHAUSTED тощо).
+ */
+export function isQuota429Error(err: unknown): boolean {
+  if (!err) return false;
+  if (typeof err === 'object') {
+    const errorObj = err as Record<string, unknown>;
+    const status = errorObj.status ?? errorObj.statusCode;
+    if (status === 429 || status === '429') return true;
+
+    const message = String(errorObj.message ?? errorObj.toString?.() ?? '');
+    if (
+      message.includes('429') ||
+      message.includes('RESOURCE_EXHAUSTED') ||
+      message.toLowerCase().includes('quota') ||
+      message.toLowerCase().includes('rate limit')
+    ) {
+      return true;
+    }
+  }
+  const str = String(err);
+  if (
+    str.includes('429') ||
+    str.includes('RESOURCE_EXHAUSTED') ||
+    str.toLowerCase().includes('quota') ||
+    str.toLowerCase().includes('rate limit')
+  ) {
+    return true;
+  }
+  return false;
+}
